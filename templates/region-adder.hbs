<div>
  {{#unless hasScene}}
    <p class="da-region-empty">{{localize "DAT.Region.EmptyScene"}}</p>
  {{else}}

    <div class="da-field-card">
      <p class="da-region-info">
        <strong>{{localize "DAT.Region.SceneLabel"}}</strong> {{sceneName}}<br/>
        <strong>{{localize "DAT.Region.TotalLevelsLabel"}}</strong> {{levelCount}}
      </p>
    </div>

    <div class="da-field-card">
      <div class="form-group da-inline-group">
        <label>{{localize "DAT.Region.StartingLevel"}}</label>
        <div class="form-fields">
          <select name="startingLevelId">
            {{#each levels}}
              <option value="{{_id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      <p class="hint">{{localize "DAT.Region.StartingLevelHint"}}</p>
    </div>

    <div class="da-field-card">
      <div class="form-group da-inline-group">
        <label>{{localize "DAT.Region.LevelsUp"}}</label>
        <div class="form-fields">
          <input type="number" name="upCount" min="0" max="{{maxUp}}" value="0" />
        </div>
      </div>
      <p class="hint">{{localize "DAT.Region.LevelsUpHint"}}</p>
    </div>

    <div class="da-field-card">
      <div class="form-group da-inline-group">
        <label>{{localize "DAT.Region.LevelsDown"}}</label>
        <div class="form-fields">
          <input type="number" name="downCount" min="0" max="{{maxDown}}" value="0" />
        </div>
      </div>
      <p class="hint">{{localize "DAT.Region.LevelsDownHint"}}</p>
    </div>

    <div class="da-field-card">
      <p><strong>{{localize "DAT.Region.WillAppearOn"}}</strong></p>
      <ul class="da-region-target-list"></ul>
    </div>

    <p class="hint da-region-place-hint">{{localize "DAT.Region.PlaceHint"}}</p>

    <footer class="sheet-footer flexrow">
      <button type="button" data-action="pickLocation">
        <i class="fas fa-crosshairs"></i> {{localize "DAT.Region.PlaceBtn"}}
      </button>
    </footer>

  {{/unless}}
</div>
